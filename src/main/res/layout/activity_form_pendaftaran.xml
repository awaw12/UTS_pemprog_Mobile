<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gradient"
            android:padding="24dp"
            android:paddingTop="36dp"
            android:paddingBottom="32dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/utb"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Form Pendaftaran"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-black" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Seminar Registration App - UTB"
                        android:textColor="#80FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Step indicator -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Data Diri" android:textColor="#FFD54F" android:textSize="12sp"
                    android:background="#2AFFFFFF" android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp" />
                <View android:layout_width="20dp" android:layout_height="1dp"
                    android:background="#50FFFFFF" android:layout_marginHorizontal="4dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Seminar" android:textColor="#80FFFFFF" android:textSize="12sp"
                    android:paddingHorizontal="12dp" android:paddingVertical="4dp" />
                <View android:layout_width="20dp" android:layout_height="1dp"
                    android:background="#50FFFFFF" android:layout_marginHorizontal="4dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Konfirmasi" android:textColor="#80FFFFFF" android:textSize="12sp"
                    android:paddingHorizontal="12dp" android:paddingVertical="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Form Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Card Data Pribadi -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:orientation="horizontal"
                        android:gravity="center_vertical" android:layout_marginBottom="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="👤" android:textSize="20sp" android:layout_marginEnd="8dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Data Pribadi"
                            android:textSize="16sp" android:fontFamily="sans-serif-black"
                            android:textColor="#1A237E" />
                    </LinearLayout>

                    <!-- Nama -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilNama"
                        style="@style/Widget.SeminarApp.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nama Lengkap *"
                        app:startIconDrawable="@android:drawable/ic_menu_myplaces"
                        android:layout_marginBottom="14dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNama"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName"
                            android:imeOptions="actionNext" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Email -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilEmail"
                        style="@style/Widget.SeminarApp.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Email *"
                        app:startIconDrawable="@android:drawable/ic_dialog_email"
                        android:layout_marginBottom="14dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:imeOptions="actionNext" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Nomor HP -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilNoHp"
                        style="@style/Widget.SeminarApp.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Nomor HP (08xxxxxxxxxx) *"
                        app:startIconDrawable="@android:drawable/ic_menu_call"
                        android:layout_marginBottom="14dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNoHp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="phone"
                            android:imeOptions="actionDone" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Jenis Kelamin -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jenis Kelamin *"
                        android:textSize="13sp"
                        android:textColor="#546E7A"
                        android:layout_marginBottom="8dp" />

                    <RadioGroup
                        android:id="@+id/rgJenisKelamin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbLakiLaki"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="👨 Laki-laki"
                            android:textColor="#37474F"
                            android:buttonTint="@color/primary" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbPerempuan"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="👩 Perempuan"
                            android:textColor="#37474F"
                            android:buttonTint="@color/primary" />
                    </RadioGroup>

                    <TextView
                        android:id="@+id/tvErrorJK"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jenis kelamin harus dipilih"
                        android:textColor="@color/error"
                        android:textSize="12sp"
                        android:visibility="gone"
                        android:layout_marginBottom="4dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card Pilihan Seminar -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:orientation="horizontal"
                        android:gravity="center_vertical" android:layout_marginBottom="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="🏛️" android:textSize="20sp" android:layout_marginEnd="8dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Pilih Seminar"
                            android:textSize="16sp" android:fontFamily="sans-serif-black"
                            android:textColor="#1A237E" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pilih seminar yang ingin diikuti *"
                        android:textSize="13sp"
                        android:textColor="#546E7A"
                        android:layout_marginBottom="8dp" />

                    <!-- Spinner with card background -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#F5F7FF"
                        android:layout_marginBottom="8dp">

                        <Spinner
                            android:id="@+id/spinnerSeminar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="12dp"
                            android:entries="@array/daftar_seminar"
                            android:background="@null" />
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/tvErrorSeminar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Seminar harus dipilih"
                        android:textColor="@color/error"
                        android:textSize="12sp"
                        android:visibility="gone" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card Persetujuan -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:orientation="horizontal"
                        android:gravity="center_vertical" android:layout_marginBottom="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="📜" android:textSize="20sp" android:layout_marginEnd="8dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Persetujuan"
                            android:textSize="16sp" android:fontFamily="sans-serif-black"
                            android:textColor="#1A237E" />
                    </LinearLayout>

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbPersetujuan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Saya menyetujui data yang diinput benar dan siap bertanggung jawab atas kebenaran data tersebut."
                        android:textColor="#37474F"
                        android:textSize="13sp"
                        android:buttonTint="@color/primary"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvErrorCheckbox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Anda harus menyetujui pernyataan di atas"
                        android:textColor="@color/error"
                        android:textSize="12sp"
                        android:visibility="gone" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Submit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmit"
                style="@style/Widget.SeminarApp.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📤  Submit Pendaftaran"
                android:textSize="16sp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKembali"
                style="@style/Widget.SeminarApp.ButtonOutlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="← Kembali"
                android:layout_marginBottom="24dp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>